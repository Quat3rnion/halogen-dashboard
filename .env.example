# Required. Base URL of Halogen. No other client may read its /metrics (ADR 0001).
HALOGEN_URL=http://192.168.50.177:8731

# Optional. Halogen API key, sent as a Bearer token. Set it when Halogen requires a key.
HALOGEN_API_KEY=

# Host address and port for the dashboard. Use 0.0.0.0 to open it on the LAN.
HALOGEN_DASHBOARD_BIND=127.0.0.1
HALOGEN_DASHBOARD_PORT=8790

RUST_LOG=info
TZ=UTC

# Simulator only (docker compose --profile sim up).
# Set HALOGEN_URL=http://fake-halogen:8791 to use it.
FAKE_HALOGEN_SEED=1
FAKE_HALOGEN_SPEED=1.0
FAKE_HALOGEN_CHAOS=false
